# ==============================================================================
# AgentSwarm Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file or real secrets to source control.
# ==============================================================================

# Database Connection (PostgreSQL with psycopg3 driver for checkpointer)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentswarm

# Security & Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# AI & LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Search & Research Tools
TAVILY_API_KEY=your_tavily_api_key_here

# Local Storage Paths (Optional: defaults to local directories)
ARTIFACTS_DIR=./artifacts
CHROMA_DB_PATH=./chroma_db

# Frontend Application URL (for email links & CORS)
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (Optional: for password reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@agentswarm.local
